{
  "expo": {
    "name": "Tickle",
    "slug": "routine-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tickle",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "com.maywalan.tickle",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "CFBundleAllowMixedLocalizations": true
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.maywalan.tickle"
        ],
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "appleTeamId": "UGG5ZR65UP"
    },
    "android": {
      "package": "com.maywalan.tickle",
      "adaptiveIcon": {
        "backgroundColor": "#FBFCFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 130,
          "dark": {
            "backgroundColor": "#141D30"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tickle to access your photos to attach one to a plan or use as your profile photo.",
          "cameraPermission": "Allow Tickle to use the camera to take your profile photo.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1B76E8",
          "sounds": [
            "./assets/sounds/tickle_chime.caf",
            "./assets/sounds/tickle_classic.caf",
            "./assets/sounds/tickle_beep.caf",
            "./assets/sounds/tickle_marimba.caf",
            "./assets/sounds/tickle_rise.caf",
            "./assets/sounds/tickle_pulse.caf"
          ]
        }
      ],
      "expo-localization",
      "@bacons/apple-targets",
      "expo-iap",
      "./plugins/withStoreKitConfig",
      ["expo-audio", { "microphonePermission": false, "recordAudioAndroid": false }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a1459f51-044f-4fe0-95c5-7c4254543c79"
      }
    },
    "owner": "maywalan",
    "locales": {
      "en": "./locales/en.json",
      "th": "./locales/th.json"
    },
    "updates": {
      "url": "https://u.expo.dev/a1459f51-044f-4fe0-95c5-7c4254543c79"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
