# Enables location autocomplete suggestions on the Add/Edit Plan screen (Google Places API).
# Copy this file to .env, fill in a real key, and restart `npx expo start`.
# Without this, the Location field still works as plain free text — suggestions are just off.
#
# To get a key: console.cloud.google.com -> create/select a project -> enable "Places API (New)"
# -> Credentials -> Create API key. Restrict it to the Places API before shipping.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
